{
  "name": "@lattice/lattice-address-validation",
  "version": "3.0.0",
  "description": "Validate Lattice Taproot (P2TR) addresses using bech32m encoding for mainnet, testnet, regtest, and simnet networks.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check-format": "prettier --check src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "lint": "tsc --noEmit",
    "ci": "pnpm run build && pnpm run check-format && pnpm run check-exports && pnpm run lint && pnpm run test",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "pnpm run ci"
  },
  "keywords": [
    "address",
    "lattice",
    "codeminute",
    "validation",
    "mainnet",
    "testnet",
    "regtest",
    "simnet",
    "bech32m",
    "taproot",
    "p2tr",
    "witness-v1"
  ],
  "author": {
    "name": "Lattice contributors",
    "url": "https://github.com/codeminute-the-dev/lattice",
    "url": "https://lattice.codeminute.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeminute-the-dev/lattice/apps/packages/lattice-address-validation"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.3",
    "@changesets/cli": "^2.27.12",
    "@types/sha.js": "^2.4.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "base58-js": "^3.0.2",
    "bech32": "^2.0.0",
    "sha256-uint8array": "^0.10.3"
  }
}