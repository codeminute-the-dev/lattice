# Copy to ~/.config/lattice/miner.env and chmod 600 (it holds the RPC password).
LATTICE_REPO=/home/you/lattice
LATTICE_VENV=/home/you/.lattice-miner/venv

# Same values as rpcuser/rpcpass/miningaddr in ~/.latticed/latticed.conf.
LATTICED_RPC_URL=http://127.0.0.1:44107
LATTICED_RPC_USER=
LATTICED_RPC_PASSWORD=
LATTICED_MINING_ADDRESS=

# systemd does not expand %t in an env file; use your own UID.
MINER_RPC_SOCKET_PATH=/run/user/1000/latticegw.sock

# Extra mine.py flags, e.g. bigger matrices: --m 4096 --n 4096 --k 2048
MINE_ARGS=
